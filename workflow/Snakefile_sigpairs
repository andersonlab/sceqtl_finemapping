def gather_cs_per_gene(wildcards):
    """Gather crediblesets only for gene x celltype pairs that exist."""
    celltype_list = [pair[1] for pair in gene_celltype_pairs if pair[0] == wildcards.gene]
    return expand("results/finemapping/{gene}/{celltype}.crediblesets.txt", gene=wildcards.gene, celltype=celltype_list)

rule all:
    input:
         expand("results/coloc/{gene}_coloc_postfinemap.txt", gene=genes),
         expand("results/coloc/{gene}_pairwise_coloc_results.txt", gene=genes)

