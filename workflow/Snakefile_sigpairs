import os
import gzip
configfile: "configs/config_sigpairs.yaml"

# Load gene x celltype pairs from input file
gene_celltype_pairs = []
gene_cond_path = config["gene_cond_file"]
print(f"..Looking for gene_cond_file at: {gene_cond_path}")
print(f"..File exists: {os.path.exists(gene_cond_path)}")

if os.path.exists(gene_cond_path):
    with gzip.open(gene_cond_path, "rt") as f:
        for line in f:
            parts = line.strip().split("\t")
            if len(parts) == 2:
                gene_celltype_pairs.append((parts[0], parts[1]))
    print(f"..Loaded {len(gene_celltype_pairs)} gene-celltype pairs")
else:
    print(f"..WARNING: gene_cond_file not found at {gene_cond_path}")

# Extract unique genes and celltypes from pairs
genes = sorted(set([pair[0] for pair in gene_celltype_pairs]))
celltypes = sorted(set([pair[1] for pair in gene_celltype_pairs]))
print(f"..Found {len(genes)} unique genes and {len(celltypes)} unique celltypes")

# Dynamically determine memory
def mem_from_input(input_file, multiplier=10, min=4000):
    """Return memory in MB as input_file_size_GB × multiplier × 1024."""
    size_bytes = os.path.getsize(input_file)
    size_gb = size_bytes / (1024**3)
    mem_mb = int(size_gb * multiplier * 1024)
    # enforce a reasonable minimum
    return max(mem_mb, min)

